# Linked to ~/.ssh/config by stow. This repo is public, so it holds no hosts.
#
# My server list lives in ~/.ssh/config.d/hosts, a private file copied by hand
# (see README > SSH hosts). Every file in ~/.ssh/config.d/ is loaded here.
Include ~/.ssh/config.d/*

Host *
	AddKeysToAgent yes
	IdentitiesOnly yes
	IdentityFile ~/.ssh/id_ed25519

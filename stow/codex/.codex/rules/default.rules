prefix_rule(pattern=["php", "artisan"], decision="allow")
prefix_rule(pattern=["composer", "audit"], decision="allow")
prefix_rule(pattern=["composer", "outdated"], decision="allow")
prefix_rule(pattern=["git", "ls-remote"], decision="allow")
prefix_rule(pattern=["rg", "--files", "resources/views", "app/Livewire", "app/Providers"], decision="allow")

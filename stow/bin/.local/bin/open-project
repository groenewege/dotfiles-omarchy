#!/usr/bin/env bash
# Start working on a project in ~/Sites (also: workon, and "Open project" in
# the Omarchy menu).
#
#   open-project <folder>   open ~/Sites/<folder>
#   open-project            pick the folder from a list
#
# Opens the site in the browser (when Lerd serves the folder), the folder in the
# editor (Zed), and the project in T3 Code (`t3 app`, which adds the folder as a
# T3 project the first time). T3 Code is started if it isn't running.
#
# Each window goes to its own Omarchy workspace (T3 Code 1, editor 2, browser 3),
# and you end up on T3 Code.
set -euo pipefail

SITES_DIR="$HOME/Sites"
T3_WORKSPACE=1
EDITOR_WORKSPACE=2
BROWSER_WORKSPACE=3

die() {
  printf '\033[31m%s\033[0m\n' "$*" >&2
  [[ -t 2 ]] || notify-send -u critical "Open project" "$*" 2>/dev/null || true
  exit 1
}

case ${1:-} in
  -h|--help) sed -n '/^set /q; 2,$p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

folder=${1:-}
if [[ -z $folder ]]; then
  mapfile -t folders < <(find "$SITES_DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' | sort)
  ((${#folders[@]})) || die "No projects in $SITES_DIR."
  folder=$(omarchy-menu-select "Project" "${folders[@]}") || exit 0
fi
dir="$SITES_DIR/$folder"
[[ -d $dir ]] || die "No project $folder in $SITES_DIR."

# Site: lerd sites lists each site's folder in its last column.
site=false
if lerd sites 2>/dev/null | awk -v d="$dir" '$NF == d { found = 1 } END { exit !found }'; then
  (cd "$dir" && setsid lerd open >/dev/null 2>&1 &)
  site=true
fi

# Editor: Omarchy's default (Zed).
setsid omarchy-launch-editor "$dir" >/dev/null 2>&1 &

# T3 Code: `t3 app` asks the running desktop app to open the folder (it creates
# the project and a thread when needed) and fails when the app isn't running.
# Start the app then, and retry until it answers (wait up to 30 s). It's
# Omarchy's self-updating AppImage, started through its launcher entry; on
# launch it also rewrites ~/.t3/bin/t3, which `t3` links to.
if ! t3 app "$dir" >/dev/null 2>&1; then
  setsid uwsm-app -- gtk-launch t3code >/dev/null 2>&1 &
  opened=false
  for _ in {1..30}; do
    sleep 0.5
    t3 app "$dir" >/dev/null 2>&1 && { opened=true; break; }
  done
  $opened || die "T3 Code didn't open $folder."
fi

# Windows, from a snapshot of Hyprland's clients taken in $clients. Zed opens
# the folder in its existing window, and the site's tab goes to the browser's
# most recently used window.
clients=""
# The most recently used window whose class matches the regex $1 (any case).
window() {
  jq -er --arg class "$1" \
    'map(select(.class | test($class; "i"))) | min_by(.focusHistoryID) | .address' <<<"$clients"
}
# xdg-settings answers omarchy-browser.desktop, Omarchy's launcher; this
# answers the browser it launches (chromium.desktop).
browser_class=$(omarchy-cmd-default-browser 2>/dev/null || true)
browser_class=${browser_class%.desktop}

move_window() { hyprctl dispatch "hl.dsp.window.move({ workspace = \"$2\", follow = false, window = \"address:$1\" })" >/dev/null; }

# The windows appear asynchronously: move each one once it's there (wait up to 10 s).
want_t3=true want_editor=true want_browser=$site t3_address=""
for _ in {1..50}; do
  clients=$(hyprctl clients -j)
  if $want_t3 && t3_address=$(window 't3code$'); then
    move_window "$t3_address" "$T3_WORKSPACE"; want_t3=false
  fi
  if $want_editor && address=$(window zed); then
    move_window "$address" "$EDITOR_WORKSPACE"; want_editor=false
  fi
  if $want_browser && address=$(window "^$browser_class\$"); then
    move_window "$address" "$BROWSER_WORKSPACE"; want_browser=false
  fi
  $want_t3 || $want_editor || $want_browser || break
  sleep 0.2
done

# The browser raises its window a moment after lerd open returns; T3 Code goes
# in front after that.
if [[ -n $t3_address ]]; then
  sleep 1
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$t3_address\" })" >/dev/null
fi

#!/usr/bin/env bash
# Clone a Laravel project into ~/Sites and get it running on Lerd.
#
#   setup-project owner/repo [folder]   clone from GitHub, then set up
#   setup-project <git-url> [folder]    clone any git URL, then set up
#   setup-project                       set up the project in the current folder
#
# Steps: check out develop (after cloning), herdr-plus project, .env from
# .env.example, PHP 8.3 pin (unless the project picks a version), Lerd site
# config (wizard the first time), composer install, lerd env, app key, migrate:fresh --seed,
# test database (created; migrated and seeded when the tests expect it), storage:link,
# npm install + build, boost:install (when laravel/boost is required).
# A failed npm step doesn't stop the setup: it is listed again at the end.
set -euo pipefail

SITES_DIR="$HOME/Sites"
PHP_VERSION="8.3"   # same as scripts/50-dev.sh

step() { printf '\n\033[1;34m==>\033[0m \033[1m%s\033[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }
die()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
problems=()
problem() { printf '\033[33m  ! %s\033[0m\n' "$*" >&2; problems+=("$*"); }

case ${1:-} in
  -h|--help) sed -n '/^set /q; 2,$p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# Clone
if (($#)); then
  repo=$1
  folder=${2:-$(basename "${repo%.git}")}
  dir="$SITES_DIR/$folder"
  [[ -e $dir ]] && die "$dir already exists. Run setup-project inside it to set it up."
  mkdir -p "$SITES_DIR"
  step "Cloning $repo into $dir"
  if [[ $repo == *:* || $repo == /* ]]; then
    git clone "$repo" "$dir"
  else
    gh repo clone "$repo" "$dir"
  fi
  cd "$dir"

  # Work happens on develop: staging and main/master deploy automatically.
  if git show-ref --verify --quiet refs/remotes/origin/develop; then
    step "Checking out develop"
    git checkout develop
  else
    note "no develop branch on origin, staying on $(git branch --show-current)"
  fi
fi

[[ -f artisan ]] || die "No artisan file in $(pwd): not a Laravel project."

# herdr-plus project (prefix+up in herdr): claude, lazygit and a shell, in the
# project folder. Done first, so it's there even if a later step fails.
step "herdr-plus project"
project=$(basename "$PWD")
working_dir=${PWD/#"$HOME"/\~}
if projects_dir="$(herdr plugin config-dir cloudmanic.herdr-plus 2>/dev/null)/projects" && [[ -d $projects_dir ]]; then
  if grep -qsxF -e "working_dir = \"$working_dir\"" -e "working_dir = \"$PWD\"" "$projects_dir"/*.toml; then
    note "a project for $working_dir already exists, keeping it"
  else
    cat >"$projects_dir/$project.toml" <<EOF
name = "$project"
working_dir = "$working_dir"

[[tabs]]
name = "claude"
command = "claude"

[[tabs]]
name = "lazygit"
command = "lazygit"

[[tabs]]
name = "terminal"
EOF
    note "added $project to herdr-plus projects"
  fi
else
  note "herdr-plus isn't installed, skipping (./install.sh --only ai installs it)"
fi

# .env
step ".env"
if [[ -f .env ]]; then
  note ".env already exists, keeping it"
elif [[ -f .env.example ]]; then
  cp .env.example .env
  note "copied .env.example to .env"
else
  die "No .env or .env.example to start from."
fi

# PHP version: Lerd uses .lerd.yaml's php_version, then .php-version, then the
# highest installed PHP that composer.json allows (so 8.5 for "^8.3"). Pin our
# default unless the project already chose. isolate refuses a version that
# composer.json rules out; Lerd's own choice stands then.
step "PHP version"
if [[ -f .php-version ]] || grep -qE '^php_version:' .lerd.yaml 2>/dev/null; then
  note "the project sets its own PHP version, keeping it"
elif ! lerd isolate "$PHP_VERSION"; then
  note "PHP $PHP_VERSION doesn't fit this project; Lerd picks the version"
fi

# Lerd site: the first time, `lerd init` asks for PHP version, HTTPS and
# services and saves the answers in .lerd.yaml (commit it). With a .lerd.yaml,
# `lerd link` applies it without asking. Both end by offering `lerd setup`,
# which would repeat the steps below; without a terminal on stdin, link skips
# that question.
step "Lerd site"
if [[ -f .lerd.yaml ]]; then
  lerd link </dev/null
else
  note "At the end, answer N to \"Run lerd setup?\": this script does those steps itself."
  lerd init
fi

step "composer install"
composer install

step "lerd env (database, cache, mail... settings for Lerd's services)"
lerd env

if ! grep -qE '^APP_KEY=.+' .env; then
  step "Generating app key"
  php artisan key:generate
fi

# migrate:fresh empties the database, so only run it against Lerd's own MySQL
# (or a local SQLite file). DB_URL would win over DB_HOST, and lerd env leaves it alone.
env_value() { grep -E "^$1=" .env | tail -1 | cut -d= -f2- | tr -d "\"'" || true; }
db_url=${DB_URL:-$(env_value DB_URL)}
db_connection=${DB_CONNECTION:-$(env_value DB_CONNECTION)}
db_host=${DB_HOST:-$(env_value DB_HOST)}
if [[ -n $db_url ]]; then
  die "DB_URL is set: refusing migrate:fresh. Remove it so Lerd's database is used."
elif [[ $db_connection != sqlite && ! $db_host =~ ^(lerd-[a-z0-9-]+|127\.0\.0\.1|localhost)$ ]]; then
  die "DB_HOST is '$db_host', not Lerd's MySQL: refusing migrate:fresh."
fi

step "Database: migrate:fresh --seed"
php artisan migrate:fresh --seed

# Test database: the one phpunit.xml names, else Lerd's <database>_testing (which
# lerd env creates). Tests using RefreshDatabase or DatabaseMigrations migrate it
# themselves; tests using only DatabaseTransactions expect it migrated and
# seeded, which artisan does through .env.testing (loaded by --env=testing).
# .env.testing is .env with phpunit.xml's values on top, so seeding sees what
# the tests see (the test database, but also e.g. a separate media disk).

# The <env>/<server> values phpunit.xml sets (comments skipped), as NAME=value.
phpunit_envs() {
  local file
  for file in phpunit.xml phpunit.xml.dist; do
    [[ -f $file ]] || continue
    perl -0pe 's/<!--.*?-->//gs' "$file" |
      grep -oE '<(env|server) name="[A-Za-z0-9_]+"[^>]*value="[^"]*"' |
      sed -E 's/.*name="([^"]+)".*value="([^"]*)".*/\1=\2/' || true
    return 0
  done
}
phpunit_env() { phpunit_envs | grep "^$1=" | tail -1 | cut -d= -f2- || true; }
if [[ -d tests && $db_connection =~ ^(mysql|mariadb)$ ]]; then
  step "Test database"
  db_database=$(env_value DB_DATABASE)
  test_db=$(phpunit_env DB_DATABASE)
  test_db=${test_db:-${db_database}_testing}
  if [[ $test_db == "$db_database" ]]; then
    problem "phpunit.xml uses the app database ($db_database) for tests: give the tests their own"
  else
    mysql -e "CREATE DATABASE IF NOT EXISTS \`$test_db\`"
    note "test database: $test_db"
    if grep -rqE '\b(RefreshDatabase|LazilyRefreshDatabase|DatabaseMigrations|DatabaseTruncation)\b' tests; then
      note "the tests migrate it themselves"
    elif grep -rqE '\bDatabaseTransactions\b' tests; then
      if [[ ! -f .env.testing ]]; then
        # Overrides first, then .env: replace the keys .env has, append the rest.
        { phpunit_envs; echo "APP_ENV=testing"; echo "DB_DATABASE=$test_db"; } |
          awk 'NR == FNR { k = $0; sub(/=.*/, "", k); v = $0; sub(/^[^=]*=/, "", v)
                           if (!(k in val)) keys[++n] = k; val[k] = v; next }
               { k = $0; sub(/=.*/, "", k)
                 if (k in val) { print k "=" val[k]; done[k] = 1 } else print }
               END { for (i = 1; i <= n; i++) if (!(keys[i] in done)) print keys[i] "=" val[keys[i]] }' \
            - .env >.env.testing
        note "created .env.testing: .env with phpunit.xml's values (DB_DATABASE=$test_db)"
        git check-ignore -q .env.testing 2>/dev/null || problem ".env.testing isn't in .gitignore: don't commit it"
      fi
      if [[ $(grep -E '^DB_DATABASE=' .env.testing | tail -1 | cut -d= -f2- | tr -d "\"'") == "$test_db" ]]; then
        step "Test database: migrate:fresh --seed (the tests expect it migrated)"
        php artisan migrate:fresh --seed --env=testing
      else
        problem ".env.testing points at another database than $test_db: migrate the test database yourself"
      fi
    fi
  fi
fi

if [[ -d storage/app/public && ! -e public/storage ]]; then
  step "storage:link"
  php artisan storage:link
fi

# npm ci installs exactly what package-lock.json lists, and refuses when
# package.json was changed without updating the lockfile (Shift's dependency
# bumps do that). npm install then resolves again and rewrites the lockfile.
if [[ -f package.json ]]; then
  step "npm install"
  npm_ok=true
  if [[ -f package-lock.json ]]; then
    if ! npm ci; then
      problem "npm ci failed, so npm install ran and updated package-lock.json: check and commit it"
      step "npm install (updates package-lock.json)"
      npm install || npm_ok=false
    fi
  else
    npm install || npm_ok=false
  fi

  if ! $npm_ok; then
    problem "npm install failed (see the error above): fix the dependencies, then install and build the assets"
  elif jq -e '.scripts.build' package.json >/dev/null; then
    step "npm run build"
    npm run build || problem "npm run build failed (see the error above)"
  elif jq -e '.scripts.production' package.json >/dev/null; then
    step "npm run production"
    npm run production || problem "npm run production failed (see the error above)"
  else
    note "no build or production script in package.json, skipping the asset build"
  fi
fi

if jq -e '(.require + (.["require-dev"] // {})) | has("laravel/boost")' composer.json >/dev/null; then
  step "Laravel Boost"
  php artisan boost:install
else
  note "laravel/boost is not required by this project, skipping boost:install"
  note "(add it with: composer require laravel/boost --dev && php artisan boost:install)"
fi

url=$(grep -E '^APP_URL=' .env | cut -d= -f2- | tr -d '"' || true)
if ((${#problems[@]})); then
  step "Done, with problems to fix:"
  for p in "${problems[@]}"; do note "- $p"; done
  note "Site: ${url:-http://$(basename "$PWD").test} (lerd open)"
  exit 1
fi
step "Done: ${url:-http://$(basename "$PWD").test} (lerd open)"
